          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE channel = 1) AS reward1, count(*) FILTER (WHERE channel = 2) AS reward2 FROM events_dev WHERE type = 'REWARD' AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AT TIME ZONE 'America/Los_Angeles'"
        }
