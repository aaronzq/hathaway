{
  "uid": "hathaway-live-rig-monitor",
  "title": "Hathaway - Live Rig Monitor",
  "tags": ["hathaway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 100,
  "editable": true,
  "liveNow": false,
  "refresh": "1s",
  "time": {
    "from": "now-1m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["500ms", "1s", "2s", "5s", "10s", "30s", "1m", "5m"],
    "quick_ranges": [
      { "display": "Last 30 seconds", "from": "now-30s", "to": "now" },
      { "display": "Last 1 minute", "from": "now-1m", "to": "now" },
      { "display": "Last 2 minutes", "from": "now-2m", "to": "now" },
      { "display": "Last 5 minutes", "from": "now-5m", "to": "now" },
      { "display": "Last 15 minutes", "from": "now-15m", "to": "now" },
      { "display": "Last 1 hour", "from": "now-1h", "to": "now" },
      { "display": "Last 3 hour", "from": "now-3h", "to": "now" },
      { "display": "Last 6 hour", "from": "now-6h", "to": "now" }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "type": "timeseries",
      "title": "Weight scale",
      "description": "",
      "datasource": { "type": "postgres", "uid": "hathaway_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT host_ts AS time, value AS weight FROM samples WHERE type = 'WEIGHT' AND $__timeFilter(host_ts) ORDER BY host_ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 4,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 6 },
      "type": "timeseries",
      "title": "Lick 1 & Reward events",
      "description": "",
      "datasource": { "type": "postgres", "uid": "hathaway_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT host_ts AS time, 1 AS lick FROM events WHERE type = 'LICK' AND channel = 1 AND $__timeFilter(host_ts) ORDER BY host_ts"
        },
        {
          "refId": "B",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT host_ts AS time, 2 AS reward FROM events WHERE type = 'REWARD' AND $__timeFilter(host_ts) ORDER BY host_ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 6,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "showValues": false,
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "max": 2.5,
          "min": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 2,
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 5 },
      "type": "timeseries",
      "title": "Mouse position and Magnet state",
      "description": "",
      "datasource": { "type": "postgres", "uid": "hathaway_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "(SELECT $__timeFrom()::timestamptz AS time, value AS position FROM samples WHERE type = 'POSITION' AND host_ts < $__timeFrom() ORDER BY host_ts DESC LIMIT 1) UNION ALL (SELECT host_ts AS time, value AS position FROM samples WHERE type = 'POSITION' AND $__timeFilter(host_ts)) ORDER BY time"
        },
        {
          "refId": "B",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "(SELECT $__timeFrom()::timestamptz AS time, value AS magnet\r\n   FROM samples\r\n  WHERE type = 'MAGNET' AND host_ts < $__timeFrom()\r\n  ORDER BY host_ts DESC LIMIT 1)\r\nUNION ALL\r\n(SELECT host_ts AS time, value AS magnet\r\n   FROM samples\r\n  WHERE type = 'MAGNET' AND $__timeFilter(host_ts))\r\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "max": 1.1,
          "min": -0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 3,
      "gridPos": { "x": 0, "y": 17, "w": 7, "h": 7 },
      "type": "gauge",
      "title": "Cumulative rewards (Total)",
      "description": "",
      "datasource": { "type": "postgres", "uid": "hathaway_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS rewards FROM events WHERE type = 'REWARD' AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AT TIME ZONE 'America/Los_Angeles'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "max": 800,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 600 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 5,
      "gridPos": { "x": 7, "y": 17, "w": 17, "h": 7 },
      "type": "timeseries",
      "title": "Cumulative rewards",
      "description": "",
      "datasource": { "type": "postgres", "uid": "hathaway_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hathaway_pg" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, reward_index FROM (SELECT host_ts AS ts, count(*) OVER (ORDER BY host_ts) AS reward_index FROM events WHERE type = 'REWARD' AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AT TIME ZONE 'America/Los_Angeles') q WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "showValues": false,
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
