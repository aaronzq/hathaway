        "name": "total_trials",
        "label": "Trials in current session",
        "description": "Trials booked in the current session, used to label the outcome pie chart's title. Gated identically to that panel's query, so the number and the slices can never disagree. Hidden: it is a read-out, not a control. refresh 2 = re-query on time-range change, which the dashboard's auto-refresh triggers.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT count(*) FROM events_dev, (SELECT date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AS lm) d WHERE type = 'OUTCOME' AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= d.lm AT TIME ZONE 'America/Los_Angeles' AND host_ts < (d.lm + interval '1 day') AT TIME ZONE 'America/Los_Angeles'",
        "refresh": 2,
