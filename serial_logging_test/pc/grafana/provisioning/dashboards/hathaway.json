    {
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 5
      },
      "type": "timeseries",
      "title": "Mouse position, Magnet and Buzzer state",
      "description": "Three 0/1 state traces, offset into separate bands so they never overlap: POSITION 0-1, MAGNET 1.5-2.5, BUZZER 3-4. The offsets are applied in SQL; the stored values are all 0/1 (and for TONE, the frequency in Hz).",
      "datasource": {
        "type": "postgres",
        "uid": "hathaway_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Keeps the 0..1 band; MAGNET and BUZZER are offset above it.\r\n(SELECT $__timeFrom()::timestamptz AS time, value AS position FROM samples_dev WHERE type = 'POSITION' AND host_ts < $__timeFrom() ORDER BY t_us DESC LIMIT 1) UNION ALL (SELECT dev_ts AS time, value AS position FROM samples_dev WHERE type = 'POSITION' AND $__timeFilter(host_ts)) ORDER BY time"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- Offset into the 1.5..2.5 band. Stored values are still 0/1.\r\n(SELECT $__timeFrom()::timestamptz AS time, value + 1.5 AS magnet\r\n   FROM samples_dev\r\n  WHERE type = 'MAGNET' AND host_ts < $__timeFrom()\r\n  ORDER BY t_us DESC LIMIT 1)\r\nUNION ALL\r\n(SELECT dev_ts AS time, value + 1.5 AS magnet\r\n   FROM samples_dev\r\n  WHERE type = 'MAGNET' AND $__timeFilter(host_ts))\r\nORDER BY time"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- Offset into the 3..4 band: 4 while a note sounds, 3 when silent.\r\n-- (TONE stores the frequency in Hz, so 'sounding' is value > 0.)\r\n--\r\n-- The first branch is the carry-in, same as POSITION and MAGNET above: it\r\n-- looks just before the window, takes the last known state and draws it at\r\n-- the left edge, so the line starts there instead of at the first row inside\r\n-- the window. Bounded to 10 minutes -- unbounded it would reach back days into\r\n-- an earlier session and paint a flat 'silent' line across a window that has\r\n-- no tone data at all.\r\n--\r\n-- Filters are on host_ts, not dev_ts: host_ts is indexed and is the hypertable\r\n-- partition key, so Postgres can skip chunks. dev_ts is computed per row, so\r\n-- filtering on it means scanning every chunk on every refresh. dev_ts is still\r\n-- what gets PLOTTED; only the row selection uses host_ts, and the two never\r\n-- differ by more than the serial read cycle.\r\n(SELECT $__timeFrom()::timestamptz AS time,\r\n        CASE WHEN value > 0 THEN 4 ELSE 3 END AS buzzer\r\n   FROM samples_dev\r\n  WHERE type = 'TONE'\r\n    AND host_ts <  $__timeFrom()::timestamptz\r\n    AND host_ts >= $__timeFrom()::timestamptz - interval '10 minutes'\r\n  ORDER BY t_us DESC LIMIT 1)\r\nUNION ALL\r\n(SELECT dev_ts AS time,\r\n        CASE WHEN value > 0 THEN 4 ELSE 3 END AS buzzer\r\n   FROM samples_dev\r\n  WHERE type = 'TONE' AND $__timeFilter(host_ts))\r\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "max": 4.1,
          "min": -0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
