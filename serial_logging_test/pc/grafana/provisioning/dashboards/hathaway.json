    {
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "type": "gauge",
      "title": "Cumulative rewards (Session)",
      "description": "Water delivered per spout in the CURRENT session -- the highest session_id, which is the one the panel is logging to right now. Closing and re-adding a port starts a new session, so this resets then; it is not a running total for the day.",
      "datasource": {
        "type": "postgres",
        "uid": "hathaway_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE channel = 1) AS reward1, count(*) FILTER (WHERE channel = 2) AS reward2 FROM events_dev WHERE type = 'REWARD' AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AT TIME ZONE 'America/Los_Angeles'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "max": 800,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 600
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
