    {
      "id": 7,
      "gridPos": {
        "x": 15,
        "y": 16,
        "w": 9,
        "h": 8
      },
      "type": "barchart",
      "title": "Trials per hour (today)",
      "description": "Trials booked in each hour of the current local day, across ALL sessions in that day. All 24 bins are always drawn: generate_series supplies the hours and the LEFT JOIN fills the empty ones with zero, so the shape of the day is visible from the first trial onwards.\n\nDeliberately ignores the dashboard time range -- it is always the whole of today, which is the point of it. Also deliberately NOT session-gated, unlike the two panels to its left: a per-hour view of the day that reset on every reconnect would not show the shape of the day.",
      "datasource": {
        "type": "postgres",
        "uid": "hathaway_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- 24 hourly bins for the current local day, zero-filled.\r\n--\r\n-- No $__timeFilter anywhere: this panel is always \"today\", whatever the\r\n-- dashboard's time picker says. That is intentional -- it is the one panel\r\n-- meant to give the shape of the whole session day while the rest of the\r\n-- dashboard sits on a 2-minute live window.\r\nWITH d AS (\r\n  SELECT date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AS lm\r\n),\r\nbins AS (\r\n  SELECT generate_series(0, 23) AS hr\r\n),\r\ntrials AS (\r\n  SELECT date_part('hour', e.host_ts AT TIME ZONE 'America/Los_Angeles')::int AS hr,\r\n         count(*) AS n\r\n    FROM events_dev e, d\r\n   WHERE e.type = 'OUTCOME'\r\n     AND e.host_ts >= d.lm AT TIME ZONE 'America/Los_Angeles'\r\n     AND e.host_ts <  (d.lm + interval '1 day') AT TIME ZONE 'America/Los_Angeles'\r\n   GROUP BY 1\r\n)\r\nSELECT lpad(b.hr::text, 2, '0') || ':00' AS \"hour\",\r\n       COALESCE(t.n, 0)::bigint          AS \"trials\"\r\n  FROM bins b\r\n  LEFT JOIN trials t ON t.hr = b.hr\r\n ORDER BY b.hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
