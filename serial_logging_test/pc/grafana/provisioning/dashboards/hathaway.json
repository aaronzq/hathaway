          "rawQuery": true,
          "rawSql": "SELECT ts AS time, reward_index AS reward2 FROM (SELECT dev_ts AS ts, count(*) OVER (ORDER BY t_us) AS reward_index FROM events_dev WHERE type = 'REWARD' AND channel = 2 AND session_id = (SELECT max(session_id) FROM sessions) AND host_ts >= date_trunc('day', now() AT TIME ZONE 'America/Los_Angeles') AT TIME ZONE 'America/Los_Angeles') q WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
