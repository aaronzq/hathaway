    {
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "type": "timeseries",
      "title": "Lick, Reward & Outcome events",
      "description": "Event rasters, each series pinned to its own y so they never overlap: lick1 1, reward1 1.5, lick2 3, reward2 3.5, and every trial outcome on one row at 5 -- 1.5 above reward2, colour-coded by outcome. The y values are constants in SQL and carry no meaning beyond keeping the rows apart.",
      "datasource": {
        "type": "postgres",
        "uid": "hathaway_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 1 AS lick1 FROM events_dev WHERE type = 'LICK' AND channel = 1 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 3 AS lick2 FROM events_dev WHERE type = 'LICK' AND channel = 2 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 1.5 AS reward1 FROM events_dev WHERE type = 'REWARD' AND channel = 1 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 3.5 AS reward2 FROM events_dev WHERE type = 'REWARD' AND channel = 2 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- Outcome rows. All four sit at y = 5 (reward2 + 1.5) so they read as one\r\n-- row, told apart by colour rather than by height. channel is the OUTCOME_*\r\n-- code from task.h: 0 hit, 1 incorrect, 2 no response, 3 abort.\r\n--\r\n-- Kept as four separate queries rather than one CASE, so each outcome is its\r\n-- own Grafana series and can be given its own colour and hidden from the\r\n-- legend independently.\r\nSELECT dev_ts AS time, 5 AS hit FROM events_dev WHERE type = 'OUTCOME' AND channel = 0 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 5 AS incorrect FROM events_dev WHERE type = 'OUTCOME' AND channel = 1 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 5 AS \"no response\" FROM events_dev WHERE type = 'OUTCOME' AND channel = 2 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT dev_ts AS time, 5 AS abort FROM events_dev WHERE type = 'OUTCOME' AND channel = 3 AND rig_id = $rig AND session_id = $session AND $__timeFilter(host_ts) ORDER BY t_us"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 6,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "always",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "max": 5.5,
          "min": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
