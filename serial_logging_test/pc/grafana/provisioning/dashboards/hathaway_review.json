          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- One row, one column per outcome: the pie makes a slice of each column.\nSELECT count(*) FILTER (WHERE channel = 0) AS \"hit\",\n       count(*) FILTER (WHERE channel = 1) AS \"incorrect\",\n       count(*) FILTER (WHERE channel = 2) AS \"no response\",\n       count(*) FILTER (WHERE channel = 3) AS \"abort\"\n  FROM events_dev\n WHERE type = 'OUTCOME' AND session_id = $session"
