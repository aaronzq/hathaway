            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffffff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lick2",
              "scope": "series"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9b9b9b"
                }
              }
            ]
          },
          {
