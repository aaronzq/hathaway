{
  "uid": "hathaway-session-review",
  "title": "Hathaway - Session Review",
  "tags": [
    "hathaway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "liveNow": false,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "rig",
        "label": "Rig",
        "description": "Every rig that has ever logged a session -- not just the live ones, since this dashboard is for looking backwards.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT DISTINCT rig_id FROM sessions ORDER BY 1",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "allowCustomValue": true,
        "regex": "",
        "sort": 3
      },
      {
        "name": "session",
        "label": "Session",
        "description": "Sessions on the selected rig, newest first. __text is what the dropdown shows, __value is the session_id the panels filter on. Chained to $rig, so changing the rig repopulates this list.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT to_char(started_at AT TIME ZONE 'America/Los_Angeles', 'YYYY-MM-DD HH24:MI')\n       || '   #' || session_id AS __text,\n       session_id               AS __value\n  FROM sessions\n WHERE rig_id = $rig\n ORDER BY session_id DESC",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "allowCustomValue": true,
        "regex": "",
        "sort": 0
      },
      {
        "name": "from_ms",
        "label": "from_ms",
        "description": "Epoch ms of the selected session's start, minus 1 s. Feeds the 'Load session' link's from= parameter. Hidden: it is plumbing, not a control.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT (extract(epoch FROM started_at - interval '1 second') * 1000)::bigint\n  FROM sessions WHERE session_id = $session",
        "refresh": 1,
        "hide": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "allowCustomValue": true,
        "regex": "",
        "sort": 0
      },
      {
        "name": "to_ms",
        "label": "to_ms",
        "description": "Epoch ms of the selected session's end, plus 1 s. Falls back to now() for a session still running, or one whose ingest was killed before it could stamp ended_at.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT (extract(epoch FROM COALESCE(ended_at, now()) + interval '1 second') * 1000)::bigint\n  FROM sessions WHERE session_id = $session",
        "refresh": 1,
        "hide": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "allowCustomValue": true,
        "regex": "",
        "sort": 0
      },
      {
        "name": "total_trials",
        "label": "Trials in selected session",
        "description": "Trials in the selected session, used to label the outcome pie's title. Gated identically to that panel's query so the number and the slices cannot disagree.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "hathaway_pg"
        },
        "query": "SELECT count(*) FROM events_dev WHERE type = 'OUTCOME' AND session_id = $session",
        "refresh": 1,
        "hide": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "allowCustomValue": true,
        "regex": "",
        "sort": 0,
        "skipUrlSync": true
      }
    ]
  },
  "links": [
    {
      "title": "Load selected session",
      "type": "link",
      "url": "/d/hathaway-session-review/?var-rig=${rig}&var-session=${session}&from=${from_ms}&to=${to_ms}",
      "icon": "cloud",
      "tooltip": "Snap the time range to the selected session",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    },
    {
      "title": "Live monitor",
      "type": "link",
      "url": "/d/hathaway-live-rig-monitor/",
      "icon": "external link",
      "tooltip": "Back to the live rig monitor",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
