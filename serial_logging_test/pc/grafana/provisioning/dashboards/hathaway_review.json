    {
      "id": 7,
      "gridPos": {
        "x": 15,
        "y": 16,
        "w": 9,
        "h": 8
      },
      "type": "barchart",
      "title": "Trials per hour (selected session)",
      "description": "Trials booked in each hour of the clock, for the selected session only. All 24 bins are always drawn -- generate_series supplies the hours and the LEFT JOIN zero-fills the empty ones. Ignores the time picker, like its counterpart on the live dashboard.",
      "datasource": {
        "type": "postgres",
        "uid": "hathaway_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hathaway_pg"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "-- 24 hourly bins for the selected session, zero-filled.\n--\n-- No $__timeFilter: this panel always covers the whole session, whatever the\n-- picker says, so it keeps its shape while you zoom the traces above.\nWITH bins AS (\n  SELECT generate_series(0, 23) AS hr\n),\ntrials AS (\n  SELECT date_part('hour', e.host_ts AT TIME ZONE 'America/Los_Angeles')::int AS hr,\n         count(*) AS n\n    FROM events_dev e\n   WHERE e.type = 'OUTCOME' AND e.session_id = $session\n   GROUP BY 1\n)\nSELECT lpad(b.hr::text, 2, '0') || ':00' AS \"hour\",\n       COALESCE(t.n, 0)::bigint          AS \"trials\"\n  FROM bins b\n  LEFT JOIN trials t ON t.hr = b.hr\n ORDER BY b.hr"
        }
      ],
      "fieldConfig": {
