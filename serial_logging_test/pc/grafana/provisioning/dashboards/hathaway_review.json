              "options": "abort"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lick1",
              "scope": "series"
