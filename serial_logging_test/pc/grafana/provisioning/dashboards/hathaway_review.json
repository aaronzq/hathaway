                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00f2ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reward2",
              "scope": "series"
            },
            "properties": [
              {
